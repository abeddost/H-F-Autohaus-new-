<!DOCTYPE html>
<html lang="de" class="no-js">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <meta name="description" content="<%= description %>">
    <link rel="canonical" href="<%= canonicalUrl %>">
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= title %>">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:url" content="<%= canonicalUrl %>">
    <meta property="og:locale" content="de_DE">
    <%- include('partials/head-assets') %>
</head>
<body>
<%- include('partials/nav', { active: 'kontakt' }) %>

<main id="main">
    <section class="relative pb-24 pt-32 md:pb-32 md:pt-44">
        <div class="container">
            <div class="mb-14 grid gap-8 lg:grid-cols-12 lg:items-end">
                <div class="hero-enter lg:col-span-7">
                    <p class="eyebrow mb-7">Kontakt</p>
                    <h1 class="heading">Besuchen Sie uns <span class="serif-accent">in Bodenheim.</span></h1>
                </div>
                <p class="lead reveal lg:col-span-5 lg:pb-2" style="--d:1">
                    Ihr Autohaus in der Nähe von Mainz, Nierstein und Oppenheim – rufen Sie an, schreiben Sie uns oder kommen Sie direkt vorbei.
                </p>
            </div>

            <%- include('partials/contact-block') %>
        </div>
    </section>
</main>

<%- include('partials/footer') %>

<%- include('partials/contact-modal') %>
</body>
</html>
