<%# Address, opening hours, contact form and map. Used on /kontakt and the homepage; pair with partials/contact-modal. %>
            <div class="grid gap-6 lg:grid-cols-12">
                <div class="reveal surface flex flex-col justify-between p-8 sm:p-10 lg:col-span-5">
                    <div class="space-y-7">
                        <div class="flex gap-5">
                            <div class="icon-tile"><%- include('icon', { name: 'pin' }) %></div>
                            <div>
                                <p class="text-xs uppercase tracking-[0.16em] text-faint">Adresse</p>
                                <p class="mt-1.5 text-bone">Am Kuemmerling 41a<br>55294 Bodenheim</p>
                            </div>
                        </div>
                        <div class="flex gap-5">
                            <div class="icon-tile"><%- include('icon', { name: 'phone' }) %></div>
                            <div>
                                <p class="text-xs uppercase tracking-[0.16em] text-faint">Telefon</p>
                                <a href="tel:+4917662878366" class="mt-1.5 block text-bone transition-colors hover:text-accent-light">0176 628 783 66</a>
                            </div>
                        </div>
                        <div class="flex gap-5">
                            <div class="icon-tile"><%- include('icon', { name: 'mail' }) %></div>
                            <div class="min-w-0">
                                <p class="text-xs uppercase tracking-[0.16em] text-faint">E-Mail</p>
                                <a href="mailto:hf.fahrzeuge@gmail.com" class="mt-1.5 block text-bone transition-colors hover:text-accent-light">hf.fahrzeuge@<wbr>gmail.com</a>
                            </div>
                        </div>
                        <div class="flex gap-5">
                            <div class="icon-tile"><%- include('icon', { name: 'clock' }) %></div>
                            <div>
                                <p class="text-xs uppercase tracking-[0.16em] text-faint">Öffnungszeiten</p>
                                <p class="mt-1.5 text-bone">Mo – Fr · 09:00 – 18:00 Uhr</p>
                                <p class="text-sm text-mute">Termine nach Vereinbarung</p>
                            </div>
                        </div>
                    </div>
                    <div class="mt-10 grid gap-3 sm:grid-cols-2">
                        <a href="https://wa.me/4917662878366" target="_blank" rel="noopener noreferrer" class="btn btn-primary"><%- include('icon', { name: 'whatsapp' }) %> WhatsApp</a>
                        <a href="https://www.google.com/maps/dir/?api=1&destination=Am+K%C3%BCmmerling+41a,+55294+Bodenheim" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">Route planen <%- include('icon', { name: 'arrow-up-right' }) %></a>
                    </div>
                </div>

                <div class="lg:col-span-7">
                    <div class="reveal surface h-full p-6 sm:p-10" style="--d:1">
                        <div class="mb-8 flex items-start justify-between gap-6">
                            <div>
                                <p class="font-display text-2xl font-medium tracking-tight">Anfrage senden</p>
                                <p class="mt-1.5 text-sm text-mute">Wir melden uns schnellstmöglich bei Ihnen.</p>
                            </div>
                            <span class="hidden rounded-full border border-accent/30 px-3 py-1 text-[0.7rem] uppercase tracking-[0.16em] text-accent sm:inline-block">Unverbindlich</span>
                        </div>

                        <form id="contactForm" class="space-y-5">
                            <input type="text" name="website" id="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true">
                            <div class="grid gap-5 md:grid-cols-2">
                                <div>
                                    <label for="name" class="field-label">Name</label>
                                    <input type="text" name="name" id="name" class="field" autocomplete="name" placeholder="Max Mustermann" required>
                                </div>
                                <div>
                                    <label for="email" class="field-label">E-Mail <span class="normal-case tracking-normal text-faint">*</span></label>
                                    <input type="email" name="email" id="email" class="field" autocomplete="email" placeholder="name@beispiel.de" required>
                                </div>
                            </div>

                            <div>
                                <label for="phone" class="field-label">Telefon</label>
                                <div class="flex gap-2">
                                    <span class="field flex w-auto items-center gap-2 text-mute">🇩🇪 +49</span>
                                    <input type="tel" name="phone" id="phone" class="field flex-1" autocomplete="tel-national" placeholder="176 12345678">
                                </div>
                            </div>

                            <div>
                                <label for="vehicle" class="field-label">Fahrzeug <span class="normal-case tracking-normal text-faint">*</span></label>
                                <%# site.js turns this into a searchable picker with photos; the select keeps the value and the no-JS fallback. %>
                                <div class="vpick" data-vehicle-picker>
                                    <select name="vehicleId" id="vehicle" class="field field-select" required>
                                        <option value="" disabled selected>Bitte wählen …</option>
                                        <option value="other">Sonstiges – kein bestimmtes Fahrzeug</option>
                                        <% (locals.contactVehicleGroups || []).forEach((group) => { %>
                                        <optgroup label="<%= group.make %>">
                                            <% group.options.forEach((option) => { %><option value="<%= option.value %>" data-url="<%= option.url %>" data-make="<%= group.make %>" data-name="<%= option.name %>" data-price="<%= option.price || '' %>" data-image="<%= option.image || '' %>"><%= option.label %></option><% }) %>
                                        </optgroup>
                                        <% }) %>
                                    </select>
                                </div>
                            </div>

                            <div>
                                <label for="message" class="field-label">Nachricht <span class="normal-case tracking-normal text-faint">*</span></label>
                                <textarea rows="5" name="message" id="message" class="field resize-none" placeholder="Marke, Modell, Baujahr, Kilometerstand – oder Ihr Anliegen" required></textarea>
                            </div>

                            <label class="flex cursor-pointer items-start gap-3 text-sm leading-relaxed text-mute">
                                <input type="checkbox" id="privacyConsent" name="privacyConsent" class="checkbox" required>
                                <span>
                                    Ich habe die <a href="/datenschutz" class="text-bone underline decoration-white/30 underline-offset-4 transition-colors hover:decoration-accent" target="_blank" rel="noopener noreferrer">Datenschutzerklärung</a> gelesen und stimme der Verarbeitung meiner Daten zu.
                                </span>
                            </label>

                            <div class="grid gap-3 sm:grid-cols-2">
                                <button type="submit" id="submitBtn" class="btn btn-primary w-full py-4 text-[0.95rem] disabled:cursor-wait disabled:opacity-70">
                                    <span id="submitText" class="inline-flex items-center gap-2.5"><%- include('icon', { name: 'mail' }) %> Per E-Mail senden</span>
                                    <span id="submitLoading" class="hidden">Wird gesendet …</span>
                                </button>
                                <button type="button" id="whatsappSendBtn" class="btn btn-ghost w-full py-4 text-[0.95rem]">
                                    <%- include('icon', { name: 'whatsapp' }) %> Per WhatsApp senden
                                </button>
                            </div>
                            <p class="text-xs leading-relaxed text-faint">„Per WhatsApp senden“ öffnet WhatsApp mit Ihrer fertig formulierten Anfrage – Sie müssen sie dort nur noch absenden.</p>
                        </form>
                    </div>
                </div>
            </div>

            <div class="reveal media-frame relative mt-6 h-[420px]">
                    <iframe
                        title="Standort H&F Autohaus Bodenheim auf Google Maps"
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2661.020104443268!2d8.302528776877384!3d49.93096367111846!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47bd761614f0b5eb%3A0x91e8d53d574028c5!2sAm%20K%C3%BCmmerling%2041A%2C%2055294%20Bodenheim!5e0!3m2!1sde!2sde!4v1731696312345!5m2!1sde!2sde"
                        class="map-dark absolute inset-0 h-full w-full border-0"
                        allowfullscreen=""
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
            </div>
