<!DOCTYPE html>
<html lang="de" class="no-js">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <meta name="description" content="<%= description %>">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://hf-autos.de/blog">
    <meta property="og:title" content="<%= title %>">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:image" content="https://hf-autos.de/logo-360.v1.png">
    <meta property="og:locale" content="de_DE">

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="https://hf-autos.de/blog">
    <meta property="twitter:title" content="<%= title %>">
    <meta property="twitter:description" content="<%= description %>">
    <meta property="twitter:image" content="https://hf-autos.de/logo-360.v1.png">

    <!-- Additional SEO Meta Tags -->
    <meta name="keywords" content="HF autos, HF Autohaus, H&F autos, H&F Autohaus, Autohaus Blog, Autoankauf Tipps, Autoverkauf Ratgeber, Gebrauchtwagen Tipps, Auto verkaufen Bodenheim, Autoankauf Mainz, Gebrauchtwagen kaufen">
    <meta name="author" content="H&F Autohaus Bodenheim">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://hf-autos.de/blog">

<%- include('partials/head-assets') %>
</head>
<body>
<%
const posts = [
    {
        slug: 'tipps-auto-schnell-verkaufen-bodenheim',
        category: 'Autoverkauf',
        date: '15. Januar 2024',
        title: 'Tipps, um ein Auto in Bodenheim schnell zu verkaufen',
        excerpt: 'Möchten Sie Ihr Auto schnell verkaufen? Erfahren Sie, wie Sie in Bodenheim den besten Preis für Ihr Fahrzeug erzielen.',
        image: 'https://images.unsplash.com/photo-1503376780353-7e6692767b70?w=1200&h=800&fit=crop&auto=format',
        alt: 'Auto verkaufen in Bodenheim'
    },
    {
        slug: 'wie-funktioniert-autoankauf-mainz',
        category: 'Autoankauf',
        date: '10. Januar 2024',
        title: 'Wie funktioniert Autoankauf in Mainz?',
        excerpt: 'Erfahren Sie, wie der professionelle Autoankauf in Mainz funktioniert und welche Schritte für einen fairen Verkaufsprozess wichtig sind.',
        image: 'https://images.unsplash.com/photo-1486754735734-325b5831c3ad?w=800&h=600&fit=crop&auto=format',
        alt: 'Autoankauf in Mainz'
    },
    {
        slug: 'worauf-beim-gebrauchtwagen-achten',
        category: 'Kaufratgeber',
        date: '5. Januar 2024',
        title: 'Worauf sollte man beim Gebrauchtwagen achten?',
        excerpt: 'Der Kauf eines Gebrauchtwagens erfordert Sorgfalt. Diese Checkliste hilft Ihnen, die richtige Entscheidung zu treffen.',
        image: 'https://images.unsplash.com/photo-1552519507-da3b142c6e3d?w=800&h=600&fit=crop&auto=format',
        alt: 'Gebrauchtwagen kaufen Tipps'
    }
];
const [featured, ...rest] = posts;
%>
<%- include('partials/nav', { active: 'blog' }) %>

<main id="main">
    <!-- Header -->
    <section class="relative overflow-hidden pb-16 pt-40 md:pb-20 md:pt-48">
        <div class="pointer-events-none absolute -left-40 top-10 h-[30rem] w-[30rem] rounded-full bg-accent/[0.06] blur-[120px]"></div>
        <div class="container relative">
            <nav class="hero-enter mb-10 flex items-center gap-2 text-xs uppercase tracking-[0.16em] text-faint" aria-label="Breadcrumb">
                <a href="/" class="transition-colors hover:text-bone">Home</a>
                <span>/</span>
                <span class="text-accent">Ratgeber</span>
            </nav>
            <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
                <h1 class="display reveal text-5xl md:text-7xl lg:col-span-7">Wissen rund ums <span class="serif-accent">Auto.</span></h1>
                <p class="lead reveal lg:col-span-5 lg:pb-3" style="--d:1">
                    Nützliche Tipps und Ratgeber rund um Autoankauf, Autoverkauf und Gebrauchtwagen – vom H&amp;F Autohaus Bodenheim.
                </p>
            </div>
        </div>
    </section>

    <!-- Posts -->
    <section class="pb-24 md:pb-36">
        <div class="container">
            <a href="/blog/<%= featured.slug %>" class="reveal group grid overflow-hidden rounded-3xl border border-white/[0.08] bg-ink-800/70 transition-colors duration-500 hover:border-white/20 lg:grid-cols-12">
                <div class="relative aspect-[16/10] overflow-hidden lg:col-span-7 lg:aspect-auto lg:min-h-[460px]">
                    <img src="<%= featured.image %>" alt="<%= featured.alt %>" class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1.2s] ease-out-expo group-hover:scale-[1.04]" loading="lazy">
                </div>
                <div class="flex flex-col justify-between gap-10 p-8 md:p-12 lg:col-span-5">
                    <div>
                        <div class="mb-6 flex items-center gap-4 text-xs uppercase tracking-[0.16em]">
                            <span class="text-accent"><%= featured.category %></span>
                            <span class="text-faint"><%= featured.date %></span>
                        </div>
                        <h2 class="font-display text-3xl font-medium leading-tight tracking-tight text-bone md:text-4xl" style="letter-spacing:-0.03em"><%= featured.title %></h2>
                        <p class="mt-5 leading-relaxed text-mute"><%= featured.excerpt %></p>
                    </div>
                    <span class="link-arrow">Artikel lesen <%- include('partials/icon', { name: 'arrow-up-right' }) %></span>
                </div>
            </a>

            <div class="mt-6 grid gap-6 md:grid-cols-2">
                <% rest.forEach((post, i) => { %>
                    <a href="/blog/<%= post.slug %>" class="reveal group flex flex-col overflow-hidden rounded-3xl border border-white/[0.08] bg-ink-800/70 transition-colors duration-500 hover:border-white/20" style="--d:<%= i + 1 %>">
                        <div class="relative aspect-[16/10] overflow-hidden">
                            <img src="<%= post.image %>" alt="<%= post.alt %>" class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1.2s] ease-out-expo group-hover:scale-[1.04]" loading="lazy">
                        </div>
                        <div class="flex flex-1 flex-col justify-between gap-8 p-8">
                            <div>
                                <div class="mb-5 flex items-center gap-4 text-xs uppercase tracking-[0.16em]">
                                    <span class="text-accent"><%= post.category %></span>
                                    <span class="text-faint"><%= post.date %></span>
                                </div>
                                <h2 class="font-display text-2xl font-medium leading-snug tracking-tight text-bone"><%= post.title %></h2>
                                <p class="mt-3 text-sm leading-relaxed text-mute"><%= post.excerpt %></p>
                            </div>
                            <span class="link-arrow">Artikel lesen <%- include('partials/icon', { name: 'arrow-up-right' }) %></span>
                        </div>
                    </a>
                <% }) %>
            </div>

            <!-- CTA -->
            <div class="reveal surface relative mt-24 overflow-hidden p-8 md:mt-32 md:p-14">
                <div class="pointer-events-none absolute -right-20 -top-20 h-80 w-80 rounded-full bg-accent/10 blur-[100px]"></div>
                <div class="relative grid gap-10 lg:grid-cols-12 lg:items-end">
                    <div class="lg:col-span-7">
                        <p class="eyebrow mb-6">Persönliche Beratung</p>
                        <h2 class="heading">Fragen? Wir sind <span class="serif-accent">für Sie da.</span></h2>
                        <p class="lead mt-5">Kontaktieren Sie H&amp;F Autohaus für eine professionelle und unverbindliche Beratung.</p>
                    </div>
                    <div class="flex flex-col gap-3 sm:flex-row lg:col-span-5 lg:justify-end">
                        <a href="/kontakt" class="btn btn-primary">Kontakt aufnehmen <%- include('partials/icon', { name: 'arrow-right', extra: 'arrow' }) %></a>
                        <a href="tel:+4917662878366" class="btn btn-ghost"><%- include('partials/icon', { name: 'phone' }) %> Anrufen</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

<%- include('partials/footer') %>
</body>
</html>
