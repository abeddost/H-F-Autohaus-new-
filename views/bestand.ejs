<!DOCTYPE html>
<html lang="de" class="no-js">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <meta name="description" content="<%= description %>">
    <link rel="canonical" href="<%= canonicalUrl %>">
    <meta property="og:title" content="<%= title %>">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= canonicalUrl %>">
    <%- include('partials/head-assets') %>
</head>
<body>
<%- include('partials/nav', { active: 'bestand' }) %>
<%
const fmt = n => new Intl.NumberFormat('de-DE').format(n);
const moreFiltersActive = Boolean(filters.gearbox || filters.minYear || filters.maxMileage);
const anyFilterActive = Boolean(filters.q || filters.make || filters.fuel || filters.maxPrice || moreFiltersActive);
%>
<main id="main">
    <h1 class="sr-only">Fahrzeugbestand – H&amp;F Autohaus Bodenheim</h1>
    <section class="container pb-24 pt-[5.75rem] md:pb-32" aria-label="Fahrzeuge suchen">
        <form action="/bestand#fahrzeuge" method="get" class="stock-filter">
            <div class="stock-filter-row">
                <label class="stock-field stock-search">Fahrzeugsuche<input type="search" name="q" placeholder="Marke, Modell oder Ausstattung" value="<%= filters.q %>" maxlength="160"></label>
                <% for (const [key,label,placeholder] of [['make','Marke','Alle Marken'],['fuel','Kraftstoff','Alle Kraftstoffe']]) { %>
                <label class="stock-field"><%= label %><select name="<%= key %>"><option value=""><%= placeholder %></option><% options[key].forEach(value => { %><option value="<%= value %>" <%= filters[key] === value ? 'selected' : '' %>><%= value %></option><% }) %></select></label>
                <% } %>
                <label class="stock-field">Preis bis (€)<input type="number" name="maxPrice" min="0" step="1" placeholder="Beliebig" value="<%= filters.maxPrice %>"></label>
                <label class="stock-field">Sortierung<select name="sort"><% for(const [value,label] of [['newest','Zuletzt hinzugefügt'],['price-asc','Preis aufsteigend'],['price-desc','Preis absteigend'],['mileage','Wenigste Kilometer'],['year','Neueste Erstzulassung']]) { %><option value="<%= value %>" <%= filters.sort === value ? 'selected' : '' %>><%= label %></option><% } %></select></label>
                <button class="btn btn-primary stock-submit" type="submit">Anzeigen <%- include('partials/icon', {name:'arrow-right'}) %></button>
            </div>
            <details class="stock-more" <%= moreFiltersActive ? 'open' : '' %>>
                <summary>Weitere Filter <span class="text-faint">· Getriebe, Erstzulassung, Kilometerstand</span></summary>
                <div class="stock-more-grid">
                    <label class="stock-field">Getriebe<select name="gearbox"><option value="">Alle Getriebe</option><% options.gearbox.forEach(value => { %><option value="<%= value %>" <%= filters.gearbox === value ? 'selected' : '' %>><%= value %></option><% }) %></select></label>
                    <label class="stock-field">Erstzulassung ab<input type="number" name="minYear" min="1900" max="<%= new Date().getFullYear() + 1 %>" placeholder="Alle Baujahre" value="<%= filters.minYear %>"></label>
                    <label class="stock-field">Kilometerstand bis<input type="number" name="maxMileage" min="0" step="1" placeholder="Beliebig" value="<%= filters.maxMileage %>"></label>
                </div>
            </details>
        </form>

        <div id="fahrzeuge" class="stock-results-bar">
            <h2 class="font-display text-xl font-medium tracking-tight">
                <%= available ? vehicles.length + (vehicles.length === 1 ? ' Fahrzeug' : ' Fahrzeuge') : 'Unsere Auswahl' %><% if(available && vehicles.length !== total) { %><span class="text-base text-mute"> von <%= total %></span><% } %>
            </h2>
            <div class="flex items-center gap-5 text-xs text-mute">
                <span class="hidden sm:inline">H&amp;F Autohaus · Bodenheim bei Mainz</span>
                <% if (anyFilterActive) { %><a href="/bestand#fahrzeuge" class="underline underline-offset-4 hover:text-accent">Filter zurücksetzen</a><% } %>
            </div>
        </div>

        <% if (vehicles.length) { %>
        <div class="stock-grid">
        <% vehicles.forEach(vehicle => { %>
            <%- include('partials/vehicle-card', { vehicle }) %>
        <% }) %>
        </div>
        <p class="mt-6 text-xs leading-relaxed text-mute">Änderungen, Zwischenverkauf und Irrtümer vorbehalten. Verfügbarkeit und verbindliche Fahrzeugangaben bestätigen wir Ihnen gerne persönlich.</p>
        <% } else { %>
        <div class="stock-empty"><p class="serif-accent text-4xl"><%= !available ? 'Ihr Wunschauto ist einen Klick entfernt.' : total ? 'Noch nicht das Richtige dabei?' : 'Neue Fahrzeuge sind unterwegs.' %></p><p class="mx-auto mb-7 mt-4 max-w-xl text-sm leading-relaxed text-mute"><%= !available ? 'Unser Fahrzeugbestand kann hier gerade nicht geladen werden. Entdecken Sie unsere aktuellen Angebote direkt auf mobile.de oder sprechen Sie mit uns.' : total ? 'Für diese Filter haben wir aktuell kein passendes Fahrzeug. Passen Sie Ihre Suche an – oder lassen Sie sich von uns beraten.' : 'Aktuell sind hier keine Fahrzeuge verfügbar. Wir helfen Ihnen gerne bei der Suche nach Ihrem nächsten Auto.' %></p><div class="flex flex-wrap justify-center gap-3"><% if(total) { %><a href="/bestand#fahrzeuge" class="btn btn-primary">Alle Fahrzeuge anzeigen</a><% } else { %><a href="https://home.mobile.de/HFAUTOMOBILEMAINZKOSTHEIM" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Angebote auf mobile.de <%- include('partials/icon', {name:'arrow-up-right'}) %></a><% } %><a href="tel:+4917662878366" class="btn btn-ghost">Persönlich beraten lassen</a></div></div>
        <% } %>
    </section>
</main>
<%- include('partials/footer') %>
</body>
</html>
