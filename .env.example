# Copy to .env for local development. In Vercel, set these under
# Project Settings -> Environment Variables.

# Contact form email (Resend). Without a key the site runs, but the form returns an error.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_TO_EMAIL=hf.fahrzeuge@gmail.com

# mobile.de inventory sync (use "search" for Dealer Inserats-Einbindung credentials)
MOBILE_DE_API=search
MOBILE_DE_USERNAME=
MOBILE_DE_PASSWORD=
MOBILE_DE_SELLER_ID=

# Sync endpoint secrets, at least 16 characters each (openssl rand -hex 32).
# Vercel Cron sends CRON_SECRET automatically.
SYNC_SECRET=
CRON_SECRET=

# Durable inventory storage in production (set automatically by the Upstash
# Redis Marketplace integration). Locally, data/inventory.json is used instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional
GOOGLE_STORE_CODE=
CDN_BASE_URL=
